<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>false</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <RuntimeMetadataVersion>v4.0.30319</RuntimeMetadataVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <DisableImplicitUsings>true</DisableImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <DefineConstants>$(DefineConstants);TARGET_64BIT</DefineConstants>
    <AssemblyName>osb.toolkit</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="App.cs" />
    <Compile Include="Control.cs" />
    <Compile Include="Desktop.cs" />
    <Compile Include="Desktop.Input.cs" />
    <Compile Include="Desktop.Paint.cs" />
    <Compile Include="Graphics.cs" />
    <Compile Include="Paint.cs" />
    <Compile Include="Types.cs" />
    <Compile Include="Window.cs" />
  </ItemGroup>

</Project>